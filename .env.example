# POSTERM — .env template: copy to .env and adjust.
# The .env holds the token: keep it readable by its owner only
# (chmod 600; root:root if the hub starts as root, see the README).

# --- the name shown everywhere (page, installed app, notifications) -----------
POSTERM_TITLE=POSTERM
# en (default) or fr: UI, push, CLI, logs, API errors.
POSTERM_LANG=en

# --- hub -----------------------------------------------------------------------
POSTERM_ADDR=127.0.0.1:8206
# Empty: generated on first start and kept in POSTERM_DATA/secrets/token.
POSTERM_TOKEN=
# The token spokes join with: it opens /join and nothing else. Empty: generated
# on first start and kept in POSTERM_DATA/secrets/join-token.
# POSTERM_JOIN_TOKEN=

# The labs' identity: started as root, posterm switches to it right away (empty
# = stay whoever started it). root, posterm, www-data… with what that implies.
# Fill in ONLY after `sudo config/create-usergroup.sh` (or the hub refuses to
# start) and after stopping another user's tmux server for the labs.
# POSTERM_USER=posterm
# POSTERM_GROUP=posterm

# --- spoke (posterm join) --------------------------------------------------------
# POSTERM_HUB=https://hub.example.org
# On a spoke, POSTERM_TOKEN is the hub's JOIN token. The hub URL must be https://
# unless it is this machine; POSTERM_INSECURE=1 overrides, at your own risk.
# POSTERM_INSECURE=

# --- both ------------------------------------------------------------------------
# POSTERM_NAME=machine            # default: the hostname
# POSTERM_DATA=/opt/posterm/data  # default: ~/.posterm
# POSTERM_QUIET=3
# Regex of dialogs that count as a "question". It REPLACES the default one:
# start from this (the default, src/engine.go) and add your patterns.
# POSTERM_QUESTION=(?i)(permission required|allow for session|do you want to (proceed|make|create|allow)|❯ *1\. *yes)
